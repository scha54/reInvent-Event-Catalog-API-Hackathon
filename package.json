{
  "name": "serendipity-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "infra/*",
    "fixtures",
    "tests/*"
  ],
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests tests/integration",
    "test:e2e": "vitest run --passWithNoTests tests/e2e",
    "build:web": "npm run build -w apps/web",
    "synth": "npm run synth -w infra/cdk"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
